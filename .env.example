# Salin file ini menjadi .env, lalu sesuaikan bila perlu.
# Jangan pernah commit file .env yang berisi kredensial asli.

# --- Database --------------------------------------------------------------
POSTGRES_USER=prisma
POSTGRES_PASSWORD=prisma
POSTGRES_DB=prisma_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://prisma:prisma@postgres:5432/prisma_ai

# --- Port aplikasi ---------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- AI Agent eksternal (OpenClaw atau framework lain) ----------------------
# mock    : agent simulasi berbasis aturan (default, tanpa dependensi eksternal)
# openclaw: memanggil AGENT_API_URL (/analyze, /chat, /health)
AGENT_PROVIDER=mock
AGENT_API_URL=
AGENT_API_KEY=
AGENT_TIMEOUT_SECONDS=20

# --- Model prediktif -------------------------------------------------------
# regression: Multiple Linear Regression (scikit-learn), dilatih dari riwayat proses
# mock      : ekstrapolasi tren sederhana
PREDICTIVE_PROVIDER=regression
MODEL_API_URL=
MODEL_API_KEY=
PREDICTION_HORIZON_MINUTES=30

# --- Mode simulasi ---------------------------------------------------------
# true  : simulator menghasilkan pembacaan proses (untuk demo tanpa sensor)
# false : data hanya masuk lewat POST /api/ingestion/sensor
SIMULATION_MODE=true
SIMULATION_INTERVAL_SECONDS=5
SIMULATION_SEED_HOURS=24

# --- Evaluasi penyimpangan -------------------------------------------------
# Nilai di luar [min, maks] = WARNING. Naik menjadi CRITICAL bila melewati
# batas lebih dari rasio ini dikali lebar rentang operasi.
CRITICAL_MARGIN_RATIO=0.125

# --- Frontend (opsional, saat dev tanpa proxy) -----------------------------
# VITE_API_BASE_URL=http://localhost:8000
